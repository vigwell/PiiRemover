<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\PiiRemover.Core\PiiRemover.Core.csproj" />
    <ProjectReference Include="..\PiiRemover.Data\PiiRemover.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.8" />
    <PackageReference Include="PdfPig" Version="0.1.14" />
    <PackageReference Include="PDFtoImage" Version="5.2.1" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.4" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.3.1" />
    <PackageReference Include="System.Speech" Version="9.0.0" />
  </ItemGroup>

  <!-- Copy tessdata to output so Tesseract can find traineddata files at runtime -->
  <ItemGroup>
    <Content Include="tessdata\*.traineddata">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- FFmpeg binaries — bundled for publish; excluded from git via .gitignore -->
  <ItemGroup>
    <Content Include="tools\ffmpeg\ffmpeg.exe" Condition="Exists('tools\ffmpeg\ffmpeg.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <None Update="tools\ffmpeg\avcodec-62.dll;tools\ffmpeg\avdevice-62.dll;tools\ffmpeg\avfilter-11.dll;tools\ffmpeg\avformat-62.dll;tools\ffmpeg\avutil-60.dll;tools\ffmpeg\ffplay.exe;tools\ffmpeg\ffprobe.exe;tools\ffmpeg\swresample-6.dll;tools\ffmpeg\swscale-9.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <!-- Copy license.lic to output dir on every build so F5 in VS finds it -->
  <ItemGroup>
    <Content Include="license.lic" Condition="Exists('license.lic')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>false</UseWindowsForms>
  </PropertyGroup>

</Project>
