@page "/admin"
@model PiiRemover.Api.Pages.Admin.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Dashboard";
    ViewData["Nav"] = "home";

    var licenseOk      = Model.DaysUntilExpiry > 30;
    var licenseWarn    = Model.DaysUntilExpiry is > 0 and <= 30;
    var licenseExpired = Model.DaysUntilExpiry == 0;
    var lastReq        = IndexModel.TimeAgo(Model.Stats.LastRequestAt);
    var errorRate      = Model.Stats.TotalCalls7d > 0
        ? (double)Model.Stats.ErrorCount7d / Model.Stats.TotalCalls7d * 100
        : 0;
    var allGreen       = !licenseExpired && !licenseWarn;
}

<style>
/* ── Health strip ──────────────────────────────────────────────────── */
.health-strip {
  display:flex; align-items:center; gap:0; flex-wrap:wrap;
  background:var(--surface); border:1px solid var(--border);
  border-radius:8px; margin-bottom:20px; overflow:hidden;
}
.hs-status {
  display:flex; align-items:center; gap:8px; padding:11px 18px;
  font-size:13px; font-weight:600; min-width:200px;
  background:@(allGreen ? "rgba(82,196,26,.08)" : licenseWarn ? "rgba(250,173,20,.08)" : "rgba(255,77,79,.08)");
  border-right:1px solid var(--border);
}
.hs-dot {
  width:9px; height:9px; border-radius:50%;
  background:@(allGreen ? "#52c41a" : licenseWarn ? "#faad14" : "#ff4d4f");
  box-shadow:0 0 6px @(allGreen ? "rgba(82,196,26,.6)" : licenseWarn ? "rgba(250,173,20,.6)" : "rgba(255,77,79,.6)");
  animation: pulse 2s infinite;
}
@@keyframes pulse {
  0%,100% { opacity:1; } 50% { opacity:.5; }
}
.hs-item {
  display:flex; align-items:center; gap:6px; padding:11px 16px;
  font-size:12px; color:var(--text2); border-right:1px solid var(--border);
  white-space:nowrap;
}
.hs-item:last-child { border-right:none; }
.hs-label { color:var(--text3); }

/* ── KPI row ───────────────────────────────────────────────────────── */
.kpi-row { display:grid; grid-template-columns:repeat(6,1fr); gap:12px; margin-bottom:20px; }
@@media(max-width:900px) { .kpi-row { grid-template-columns:repeat(3,1fr); } }
@@media(max-width:560px) { .kpi-row { grid-template-columns:repeat(2,1fr); } }
.kpi {
  background:var(--surface); border:1px solid var(--border); border-radius:8px;
  padding:16px 18px; position:relative; overflow:hidden;
}
.kpi-val  { font-size:26px; font-weight:800; color:var(--title); line-height:1.1; }
.kpi-lbl  { font-size:11px; color:var(--text3); margin-top:4px; font-weight:500; letter-spacing:.3px; text-transform:uppercase; }
.kpi-sub  { font-size:11px; color:var(--text3); margin-top:2px; }
.kpi-icon { position:absolute; right:14px; top:14px; font-size:20px; opacity:.15; }
.kpi.accent-blue  { border-top:2px solid #1677ff; }
.kpi.accent-green { border-top:2px solid #52c41a; }
.kpi.accent-red   { border-top:2px solid #ff4d4f; }
.kpi.accent-amber { border-top:2px solid #faad14; }

/* ── Activity feed ─────────────────────────────────────────────────── */
.feed { display:flex; flex-direction:column; gap:0; }
.feed-row {
  display:grid; grid-template-columns:70px 1fr auto 70px 32px;
  gap:8px; align-items:center;
  padding:9px 14px; border-bottom:1px solid var(--border); font-size:12px;
  transition:background .1s;
}
.feed-row:last-child  { border-bottom:none; }
.feed-row:hover       { background:var(--surface2); }
.feed-time   { color:var(--text3); font-variant-numeric:tabular-nums; white-space:nowrap; }
.feed-file   { color:var(--text); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.feed-fields { display:flex; gap:4px; flex-wrap:wrap; }
.feed-dur    { color:var(--text3); text-align:right; white-space:nowrap; }
.feed-tag {
  background:rgba(22,119,255,.1); color:#4a90d9;
  border:1px solid rgba(22,119,255,.2); border-radius:4px;
  padding:1px 6px; font-size:10px; white-space:nowrap;
}
.feed-tag.error { background:rgba(255,77,79,.1); color:#ff4d4f; border-color:rgba(255,77,79,.2); }
.feed-ok   { color:#52c41a; font-size:14px; text-align:center; }
.feed-err  { color:#ff4d4f; font-size:14px; text-align:center; }
.feed-empty { padding:24px; text-align:center; color:var(--text3); font-size:13px; }
</style>

<h1 class="page-title">Dashboard</h1>

@if (licenseExpired)
{
    <div class="alert alert-danger">⛔ License has expired. API requests are blocked until renewed.</div>
}
else if (licenseWarn)
{
    <div class="alert alert-warning">
        ⚠️ License expires in <strong>@Model.DaysUntilExpiry day(s)</strong>
        (@Model.LicenseExpiry.ToString("yyyy-MM-dd")). Contact your vendor to renew.
    </div>
}

<!-- ══════════════════════════════════════════════════════ HEALTH STRIP -->
<div class="health-strip">
  <div class="hs-status">
    <div class="hs-dot"></div>
    @if (allGreen)       { <span>All systems operational</span> }
    else if (licenseWarn){ <span style="color:#faad14">License expiring soon</span> }
    else                 { <span style="color:#ff4d4f">License expired</span> }
  </div>

  <div class="hs-item">
    <span class="hs-label">Database</span>
    <span style="color:#52c41a;font-weight:600">✓ OK</span>
  </div>

  <div class="hs-item">
    <span class="hs-label">License</span>
    @if (licenseExpired)
    { <span style="color:#ff4d4f;font-weight:600">Expired</span> }
    else if (licenseWarn)
    { <span style="color:#faad14;font-weight:600">@Model.DaysUntilExpiry d remaining</span> }
    else
    { <span style="color:#52c41a;font-weight:600">Valid · @Model.DaysUntilExpiry d</span> }
  </div>

  <div class="hs-item">
    <span class="hs-label">Last request</span>
    <span>@lastReq</span>
  </div>

  <div class="hs-item" style="margin-left:auto">
    <span class="hs-label">Logged in as</span>
    <span style="font-weight:600">@User.Identity?.Name</span>
  </div>
</div>

<!-- ══════════════════════════════════════════════════════════ KPI ROW -->
<div class="kpi-row">

  <div class="kpi accent-blue">
    <div class="kpi-icon">📅</div>
    <div class="kpi-val">@Model.Stats.TodayCount.ToString("N0")</div>
    <div class="kpi-lbl">Requests Today</div>
  </div>

  <div class="kpi accent-blue">
    <div class="kpi-icon">📊</div>
    <div class="kpi-val">@Model.Stats.TotalCalls7d.ToString("N0")</div>
    <div class="kpi-lbl">Last 7 Days</div>
  </div>

  <div class="kpi @(Model.Stats.AvgDurationMs > 1000 ? "accent-amber" : "accent-green")">
    <div class="kpi-icon">⚡</div>
    <div class="kpi-val">
      @if (Model.Stats.AvgDurationMs == 0) { <text>—</text> }
      else if (Model.Stats.AvgDurationMs < 1000) { <text>@Model.Stats.AvgDurationMs<span style="font-size:14px;font-weight:400"> ms</span></text> }
      else { <text>@((Model.Stats.AvgDurationMs / 1000.0).ToString("F1"))<span style="font-size:14px;font-weight:400"> s</span></text> }
    </div>
    <div class="kpi-lbl">Avg Processing</div>
    <div class="kpi-sub">7-day average</div>
  </div>

  <div class="kpi @(Model.Stats.ErrorCount7d > 0 ? "accent-red" : "accent-green")">
    <div class="kpi-icon">@(Model.Stats.ErrorCount7d > 0 ? "⚠️" : "✅")</div>
    <div class="kpi-val" style="color:@(Model.Stats.ErrorCount7d > 0 ? "#ff4d4f" : "#52c41a")">
      @Model.Stats.ErrorCount7d
    </div>
    <div class="kpi-lbl">Errors (7d)</div>
    <div class="kpi-sub">@(errorRate > 0 ? $"{errorRate:F1}% error rate" : "Clean run")</div>
  </div>

  <div class="kpi">
    <div class="kpi-icon">🔒</div>
    <div class="kpi-val">@Model.TotalFields</div>
    <div class="kpi-lbl">PII Fields</div>
    <div class="kpi-sub">@Model.TotalPatterns patterns</div>
  </div>

  <div class="kpi">
    <div class="kpi-icon">📋</div>
    <div class="kpi-val">@Model.TotalLogs.ToString("N0")</div>
    <div class="kpi-lbl">Total Requests</div>
    <div class="kpi-sub">All time</div>
  </div>

</div>

<!-- ══════════════════════════════════════════════════ CHART + TOP FIELDS -->
<div class="grid-2" style="margin-bottom:20px">

  <div class="card">
    <h3 style="display:flex;justify-content:space-between;align-items:center">
      API Activity
      <span style="font-size:11px;color:var(--text3);font-weight:400">Last 30 days</span>
    </h3>
    @{
      var maxCalls = Model.DailyCalls.Count > 0 ? Math.Max(1, Model.DailyCalls.Max(d => d.Count)) : 1;
      const int chartH = 90;
      const int barW   = 14;
      const int gap    = 3;
      var totalW = Model.DailyCalls.Count * (barW + gap) - gap;
    }
    @if (!Model.DailyCalls.Any())
    {
      <p style="color:var(--text3);font-size:12px;text-align:center;padding:20px 0">No activity yet.</p>
    }
    else
    {
      <svg width="100%" viewBox="0 0 @totalW @(chartH + 20)" preserveAspectRatio="none"
           style="overflow:visible;display:block;margin:0 auto">
        @for (int i = 0; i < Model.DailyCalls.Count; i++)
        {
          var d = Model.DailyCalls[i];
          var h = (int)Math.Max(2, Math.Round((double)d.Count / maxCalls * chartH));
          var x = i * (barW + gap);
          var y = chartH - h;
          var isToday = i == Model.DailyCalls.Count - 1;
          <rect x="@x" y="@y" width="@barW" height="@h"
                fill="@(isToday ? "#1677ff" : "#1677ff")"
                fill-opacity="@(d.Count == 0 ? "0.08" : isToday ? "0.9" : "0.55")"
                rx="2">
            <title>@d.Day: @d.Count.ToString("N0") call(s)</title>
          </rect>
          @if (d.Count > 0 && isToday)
          {
            @Html.Raw($"<text x=\"{x + barW/2}\" y=\"{y - 3}\" text-anchor=\"middle\" font-size=\"8\" fill=\"#1677ff\" font-weight=\"600\">{d.Count}</text>")
          }
          @if (i % 7 == 0 && d.Day.Length >= 5)
          {
            @Html.Raw($"<text x=\"{x + barW/2}\" y=\"{chartH + 14}\" text-anchor=\"middle\" font-size=\"8\" fill=\"currentColor\" opacity=\".4\">{d.Day[5..]}</text>")
          }
        }
      </svg>
      <div style="display:flex;justify-content:space-between;font-size:11px;color:var(--text3);margin-top:4px">
        <span>@Model.DailyCalls.FirstOrDefault()?.Day</span>
        <span>Today</span>
      </div>
    }
  </div>

  <div class="card">
    <h3 style="display:flex;justify-content:space-between;align-items:center">
      Top PII Fields
      <span style="font-size:11px;color:var(--text3);font-weight:400">Last 30 days</span>
    </h3>
    @if (!Model.TopFields.Any())
    {
      <p style="color:var(--text3);font-size:12px;text-align:center;padding:20px 0">No field hits recorded yet.</p>
    }
    else
    {
      var maxHits = Model.TopFields.Max(f => f.Count);
      int fRank = 1;
      @foreach (var f in Model.TopFields)
      {
        var pct = maxHits > 0 ? (double)f.Count / maxHits * 100 : 0;
        <div style="margin-bottom:10px">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:3px">
            <span style="font-size:12px;color:var(--text)">
              <span style="color:var(--text3);margin-right:6px;font-variant-numeric:tabular-nums">@(fRank).</span>
              @f.FieldName
            </span>
            <span style="font-size:12px;font-weight:700;color:#1677ff">@f.Count.ToString("N0")</span>
          </div>
          <div style="height:4px;background:var(--border);border-radius:2px">
            <div style="height:4px;width:@($"{pct:F0}")%;background:linear-gradient(90deg,#1677ff,#4096ff);border-radius:2px;transition:width .4s"></div>
          </div>
        </div>
        fRank++;
      }
    }
  </div>

</div>

<!-- ══════════════════════════════════════════════════ RECENT ACTIVITY -->
<div class="card" style="padding:0">
  <div style="padding:14px 18px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center">
    <h3 style="margin:0">Recent Activity</h3>
    <a href="/admin/logs" style="font-size:12px;color:#1677ff">View all logs →</a>
  </div>

  @if (!Model.RecentActivity.Any())
  {
    <div class="feed-empty">No requests processed yet. Use the API or the Live Tester to get started.</div>
  }
  else
  {
    <div class="feed">
      <div class="feed-row" style="background:var(--surface2);font-size:11px;color:var(--text3);font-weight:600;text-transform:uppercase;letter-spacing:.4px">
        <span>Time</span><span>File</span><span>Fields hit</span><span style="text-align:right">Duration</span><span></span>
      </div>
      @foreach (var log in Model.RecentActivity)
      {
        var fields  = IndexModel.ParseFields(log.FieldsHit);
        var isError = !string.IsNullOrEmpty(log.ErrorMsg);
        var ago     = IndexModel.TimeAgo(log.RequestedAt);
        <div class="feed-row">
          <span class="feed-time">@ago</span>
          <span class="feed-file" title="@log.FileName">@(log.FileName ?? "—")</span>
          <span class="feed-fields">
            @if (isError)
            {
              <span class="feed-tag error" title="@log.ErrorMsg">error</span>
            }
            else if (!fields.Any())
            {
              <span style="color:var(--text3);font-size:11px">no matches</span>
            }
            else
            {
              @foreach (var f in fields.Take(4))
              { <span class="feed-tag">@f</span> }
              @if (fields.Count > 4)
              { <span class="feed-tag" style="background:var(--surface2);color:var(--text3);border-color:var(--border)">+@(fields.Count-4)</span> }
            }
          </span>
          <span class="feed-dur">@log.DurationMs ms</span>
          <span class="@(isError ? "feed-err" : "feed-ok")">@(isError ? "✗" : "✓")</span>
        </div>
      }
    </div>
  }
</div>
