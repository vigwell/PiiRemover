@page "/admin/about"
@model PiiRemover.Api.Pages.Admin.AboutModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "About";
    ViewData["Nav"] = "about";
}

<h1 class="page-title">About PiiRemover</h1>

<div class="grid-2">

  <!-- Product identity card -->
  <div class="card" style="text-align:center;padding:32px 24px">
    <div style="font-size:52px;margin-bottom:10px">🔒</div>
    <div style="font-size:24px;font-weight:700;color:var(--title);letter-spacing:.5px">PiiRemover</div>
    <div style="font-size:13px;color:var(--text3);margin:6px 0 16px">Enterprise PII Detection &amp; Redaction Platform</div>
    <div style="display:inline-block;background:rgba(22,119,255,.1);color:#1677ff;border:1px solid rgba(22,119,255,.25);border-radius:12px;padding:4px 16px;font-size:13px;font-weight:600;margin-bottom:18px">
      Version 3.0.11
    </div>
    <p style="font-size:12px;color:var(--text2);line-height:1.8;max-width:320px;margin:0 auto">
      PiiRemover automatically detects and redacts personally identifiable information
      from documents, images, and scanned files — protecting privacy before data
      leaves your organisation.
    </p>
  </div>

  <!-- License -->
  <div class="card">
    <h3>License</h3>
    <table>
      <tr><td>Organisation</td><td><strong>@Model.License.OrgName</strong></td></tr>
      <tr><td>License ID</td><td><span class="mono">@Model.License.LicenseId</span></td></tr>
      <tr><td>Issued</td><td>@Model.License.IssuedDate.ToString("yyyy-MM-dd")</td></tr>
      <tr><td>Expires</td><td>
        @if (Model.DaysUntilExpiry <= 7)
          { <span class="badge badge-red">@Model.License.ExpiryDate.ToString("yyyy-MM-dd") (@Model.DaysUntilExpiry d)</span> }
        else if (Model.DaysUntilExpiry <= 30)
          { <span class="badge badge-blue">@Model.License.ExpiryDate.ToString("yyyy-MM-dd") (@Model.DaysUntilExpiry d)</span> }
        else
          { <span class="badge badge-green">@Model.License.ExpiryDate.ToString("yyyy-MM-dd")</span> }
      </td></tr>
      <tr><td>Max Clients</td><td>@Model.License.MaxClients</td></tr>
      <tr><td>Features</td><td>@string.Join(", ", Model.License.Features)</td></tr>
    </table>
  </div>

</div>

<div class="grid-2">

  <!-- What it does -->
  <div class="card">
    <h3>What PiiRemover Does</h3>
    <ul style="font-size:13px;color:var(--text2);line-height:2.3;padding-left:18px">
      <li>Scans documents, PDFs, images, and scanned files for sensitive personal information</li>
      <li>Replaces names, identity numbers, phone numbers, dates, and other PII with redaction marks</li>
      <li>Supports Hebrew, Arabic, and English documents including right-to-left text</li>
      <li>Processes files via a secure REST API callable from any application</li>
      <li>Provides full audit logs of every redaction request for compliance purposes</li>
      <li>Allows fine-grained control over which fields are redacted and which are preserved</li>
    </ul>
  </div>

  <!-- Key capabilities -->
  <div class="card">
    <h3>Key Capabilities</h3>
    <table>
      <tr><td>🔍 Detection</td><td>Pattern-based rules, name dictionaries, and label-based field detection</td></tr>
      <tr><td>📄 Document types</td><td>PDF, scanned images, TIFF, PNG, JPEG, plain text</td></tr>
      <tr><td>🌍 Languages</td><td>Hebrew, English, Arabic, and mixed-language documents</td></tr>
      <tr><td>🛡 Preserve list</td><td>Whitelist terms that must never be redacted (e.g. institution names)</td></tr>
      <tr><td>🎯 Scope control</td><td>Restrict detection to specific regions within a document</td></tr>
      <tr><td>🔑 Multi-client</td><td>Separate API keys per application or department</td></tr>
      <tr><td>📊 Audit trail</td><td>Full request log with file name, fields matched, and duration</td></tr>
      <tr><td>⚡ Performance</td><td>Parallel processing with configurable concurrency</td></tr>
    </table>
  </div>

</div>

@if (!string.IsNullOrWhiteSpace(Model.SupportContact))
{
  <div class="card">
    <h3>Support</h3>
    <p style="color:var(--text2);font-size:13px">@Model.SupportContact</p>
  </div>
}
