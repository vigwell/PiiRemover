// ═══════════════════════════════════════════════════════════════════
// SCOPE END POSITION — capture, modal, marker
// ═══════════════════════════════════════════════════════════════════

/**
 * Calculate the character offset in the OCR pane at the given mouse coords.
 * Uses caretRangeFromPoint (Chrome/Edge) or caretPositionFromPoint (Firefox).
 * In posMode the data-from spans give an exact fast-path; otherwise falls back
 * to walking all text nodes while skipping .pos-mark / .scope-end-line content.
 */
function getCharPositionAtPoint(pane, x, y) {
  let range;
  try {
    if (document.caretRangeFromPoint) {
      range = document.caretRangeFromPoint(x, y);
    } else if (document.caretPositionFromPoint) {
      const c = document.caretPositionFromPoint(x, y);
      if (c) { range = document.createRange(); range.setStart(c.offsetNode, c.offset); }
    }
  } catch { return -1; }
  if (!range) return -1;

  // Fast path: we're inside a data-from span (posMode on)
  try {
    let el = range.startContainer.nodeType === Node.TEXT_NODE
      ? range.startContainer.parentElement : range.startContainer;
    while (el && el !== pane) {
      if (el.dataset?.from !== undefined && !el.classList.contains('pos-mark')) {
        const r2 = document.createRange();
        r2.setStart(el.firstChild || el, 0);
        r2.setEnd(range.startContainer, range.startOffset);
        return +el.dataset.from + r2.toString().length;
      }
      el = el.parentElement;
    }
  } catch {}

  // Fallback: walk text nodes, skipping non-content markers
  try {
    const walker = document.createTreeWalker(pane, NodeFilter.SHOW_TEXT, {
      acceptNode: n => n.parentElement?.closest('.pos-mark,.scope-end-line')
        ? NodeFilter.FILTER_REJECT : NodeFilter.FILTER_ACCEPT
    });
    let count = 0, node;
    while ((node = walker.nextNode())) {
      const len = node.textContent.length;
      // Is range endpoint inside this node?
      if (node === range.startContainer) { count += range.startOffset; break; }
      // Is range endpoint before this node?
      try {
        const cmp = range.comparePoint(node, 0);
        if (cmp > 0) break;   // range end is before this node
      } catch {}
      count += len;
    }
    return count;
  } catch { return -1; }
}

let scopeEndCurrentCardId = '';
let scopeEndCurrentPos    = -1;

async function openSetScopeEnd(pos, cardId) {
  scopeEndCurrentPos    = pos;
  scopeEndCurrentCardId = cardId;

  document.getElementById('scopeEndPosLabel').textContent = pos;
  document.getElementById('scopeEndStatus').textContent   = '';
  document.getElementById('scopeEndCurrentVal').textContent = '';

  // Populate FileList pattern dropdown from cachedFields
  if (!cachedFields) await reloadFields();
  const sel = document.getElementById('scopeEndPatternSelect');
  const flPatterns = (cachedFields || [])
    .flatMap(f => (f.patterns || [])
      .filter(p => p.type === 'FileList')
      .map(p => ({ patId: p.id, fieldName: f.fieldName, scopeEndPosition: p.scopeEndPosition ?? 0 })));

  if (flPatterns.length === 0) {
    sel.innerHTML = '<option value="">— no FileList patterns found —</option>';
  } else {
    sel.innerHTML = flPatterns.map(p =>
      `<option value="${p.patId}" data-cur="${p.scopeEndPosition}">
        ${h(p.fieldName)} (current: ${p.scopeEndPosition})
      </option>`).join('');
    updateScopeCurrentVal();
  }

  document.getElementById('setScopeEndModal').style.display = 'flex';
}

function closeSetScopeEnd() {
  document.getElementById('setScopeEndModal').style.display = 'none';
}

function updateScopeCurrentVal() {
  const sel = document.getElementById('scopeEndPatternSelect');
  const opt = sel.options[sel.selectedIndex];
  const cur = opt ? opt.dataset.cur : null;
  document.getElementById('scopeEndCurrentVal').textContent =
    cur != null ? `Current value: ${cur} → will be updated to ${scopeEndCurrentPos}` : '';
}

async function submitSetScopeEnd() {
  const sel       = document.getElementById('scopeEndPatternSelect');
  const patternId = +sel.value;
  if (!patternId) { setScopeEndStatus('Select a pattern first.', 'error'); return; }

  setScopeEndStatus('Saving…', 'info');
  const r = await apiPost('/admin/tester?handler=SetScopeEndPosition',
    { patternId, position: scopeEndCurrentPos });

  if (r.ok) {
    setScopeEndStatus(`✓ Saved. Scope End Position set to ${scopeEndCurrentPos}.`, 'ok');
    cachedFields = null;   // invalidate cache so next open shows fresh values

    // Draw the marker in the card that was right-clicked
    if (scopeEndCurrentCardId) {
      const s = cardStates.get(scopeEndCurrentCardId);
      if (s) {
        s.scopeEndPos = scopeEndCurrentPos;
        const pane = document.getElementById(scopeEndCurrentCardId + '-ocrPane');
        if (pane) insertScopeEndMarker(pane, scopeEndCurrentPos);
      }
    }
    setTimeout(closeSetScopeEnd, 1200);
  } else {
    setScopeEndStatus('Error: ' + (r.error || 'unknown'), 'error');
  }
}

function setScopeEndStatus(msg, type) {
  const el  = document.getElementById('scopeEndStatus');
  const clr = type === 'error' ? '#ff4d4f' : type === 'ok' ? '#52c41a' : '#1677ff';
  el.style.color   = clr;
  el.textContent   = msg;
}

/**
 * Insert (or refresh) a visible dashed "Scope End" line in the OCR pane at
 * the given character offset.  Walks text nodes, splits the node at the right
 * spot, and inserts a .scope-end-line <span> — works both with and without
 * posMode.  Replaces any previously inserted line first.
 */
function insertScopeEndMarker(pane, pos) {
  // Remove any existing marker
  pane.querySelectorAll('.scope-end-line').forEach(el => el.remove());
  if (!pos || pos <= 0) return;

  const walker = document.createTreeWalker(pane, NodeFilter.SHOW_TEXT, {
    acceptNode: n => n.parentElement?.closest('.pos-mark,.scope-end-line')
      ? NodeFilter.FILTER_REJECT : NodeFilter.FILTER_ACCEPT
  });

  let count = 0, node;
  while ((node = walker.nextNode())) {
    const len = node.textContent.length;
    if (count + len >= pos) {
      const offset = pos - count;
      const after  = node.splitText(offset);
      const marker = document.createElement('span');
      marker.className    = 'scope-end-line';
      marker.dataset.label = `◀ Scope End [${pos}]`;
      node.parentNode.insertBefore(marker, after);
      return;
    }
    count += len;
  }
  // pos is beyond all text — append at the end of the pane
  const marker = document.createElement('span');
  marker.className    = 'scope-end-line';
  marker.dataset.label = `◀ Scope End [${pos}]`;
  pane.appendChild(marker);
}

