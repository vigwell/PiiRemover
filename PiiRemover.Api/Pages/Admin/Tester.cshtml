// UTILITIES
// ═══════════════════════════════════════════════════════════════════
function overlayClose(e, id) {
  if (e.target.id === id) document.getElementById(id).style.display = 'none';
}

function syncTesterPresets() {
  const val = (document.getElementById('addNewReplace')?.value || '').trim();
  const presets = ['█','*','-','#','?','•','_','×'];
  presets.forEach(c => {
    const el = document.getElementById('tp-' + c.charCodeAt(0));
    if (!el) return;
    const sel = c === val;
    el.style.borderColor  = sel ? '#fa8c16' : 'var(--border2)';
    el.style.color        = sel ? '#fa8c16' : 'var(--text)';
    el.style.background   = sel ? 'rgba(250,140,22,.12)' : 'var(--surface)';
    el.style.fontWeight   = sel ? '700' : '';
  });
}

function detectDir(text) {
  if (!text) return 'ltr';
  const heb = (text.match(/[֐-׿]/g) || []).length;
  return heb / text.length > 0.12 ? 'rtl' : 'ltr';
}

function h(s)   { return String(s??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
function ha(s)  { return String(s??'').replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;'); }
function ea(s)  { return String(s??'').replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
function escHtml(s) { return String(s??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
function fmtSize(b) {
  if (b < 1024)    return b + ' B';
  if (b < 1048576) return (b/1024).toFixed(1) + ' KB';
  return (b/1048576).toFixed(2) + ' MB';
}
function getToken() {
  const el = document.querySelector('#__AntiForgery input[name="__RequestVerificationToken"]');
  return el ? el.value : '';
}
async function apiPost(url, body) {
  try {
    const r = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getToken() },
      body: JSON.stringify(body)
    });
    return await r.json();
  } catch (e) { return { ok: false, error: e.message }; }
}

// ── AI Tester modal ──────────────────────────────────────────────────────
let _aiTesterCardId = null;
let _aiSuggestions  = null; // cached from server

async function openAiTester(cardId) {
  const s = cardStates.get(cardId);
  if (!s?.ocrText) return;
  _aiTesterCardId = cardId;

  // Pre-fill text
  document.getElementById('aiTesterText').value = s.ocrText;
  document.getElementById('aiTesterText').dir =
    /[֐-׿יִ-ﭏ]/.test(s.ocrText) ? 'rtl' : 'ltr';

  // Reset state
  document.getElementById('aiTesterPrompt').value = '';
  document.getElementById('aiTesterResult').style.display = 'none';
  document.getElementById('aiTesterPromptLog').style.display = 'none';
  document.getElementById('aiTesterRunBtn').disabled = false;

  document.getElementById('aiTesterModal').style.display = 'flex';

  // Load suggestions + models in parallel (suggestions cached, models always fresh)
  const tasks = [];
  if (!_aiSuggestions) tasks.push(loadAiTesterSuggestions());
  tasks.push(loadAiTesterModels());
  await Promise.all(tasks);
}

function closeAiTester() {
  document.getElementById('aiTesterModal').style.display = 'none';
  _aiTesterCardId = null;
}

async function loadAiTesterSuggestions() {
  try {
    const r = await fetch('/admin/settings?handler=AiPromptSuggestions');
    if (!r.ok) return;
    _aiSuggestions = await r.json();
    const sel = document.getElementById('aiTesterSuggest');
    sel.innerHTML = '<option value="">— sample prompts —</option>';
    const groups = {};
    _aiSuggestions.forEach(s => {
      if (!groups[s.group]) groups[s.group] = [];
      groups[s.group].push(s);
    });
    Object.entries(groups).forEach(([grp, items]) => {
      const og = document.createElement('optgroup');
      og.label = grp;
      items.forEach(item => {
        const o = document.createElement('option');
        o.value = item.prompt;
        o.textContent = (item.existing ? '✓ ' : '') + item.label;
        og.appendChild(o);
      });
      sel.appendChild(og);
    });
  } catch { /* suggestions are optional */ }
}

async function loadAiTesterModels() {
  const sel    = document.getElementById('aiTesterModel');
  const status = document.getElementById('aiTesterModelStatus');
  sel.innerHTML = '<option value="">— configured model (default) —</option>';
  status.textContent = 'Loading…';
  try {
    const r = await fetch('/admin/settings?handler=ListAiModels');
    if (!r.ok) { status.textContent = ''; return; }
    const data = await r.json();
    if (!data.ok || !data.models?.length) {
      status.textContent = data.ok ? 'No models installed' : '⚠ Cannot reach AI engine';
      return;
    }
    data.models.forEach(m => {
      const o = document.createElement('option');
      o.value = m;
      o.textContent = m;
      sel.appendChild(o);
    });
    // Pre-select the currently configured model
    if (data.currentModel) sel.value = data.currentModel;
    status.textContent = `${data.models.length} model${data.models.length > 1 ? 's' : ''} available`;
  } catch { status.textContent = ''; }
}

function applyAiTesterSuggestion() {
  const sel = document.getElementById('aiTesterSuggest');
  if (sel.value) {
    document.getElementById('aiTesterPrompt').value = sel.value;
    sel.value = '';
  }
}

async function runAiTesterExtraction() {
  const prompt = document.getElementById('aiTesterPrompt').value.trim();
  const text   = document.getElementById('aiTesterText').value;
  const model  = document.getElementById('aiTesterModel').value;
  if (!prompt) { document.getElementById('aiTesterPrompt').focus(); return; }

  const btn = document.getElementById('aiTesterRunBtn');
  btn.disabled = true;
  btn.textContent = '⏳ Running…';

  const resultBox = document.getElementById('aiTesterResult');
  resultBox.style.display = 'none';

  // Build and show prompt preview immediately (mirrors server-side BuildPrompt)
  const chunk = text.length > 3000 ? text.slice(0, 3000) : text;
  const builtPrompt =
`You are a data extraction tool. Extract exact text values from the document.

STRICT RULES — follow exactly:
- Output ONLY the raw values copied from the document, one per line
- Do NOT write sentences, explanations, labels, or commentary
- Do NOT rephrase or translate — copy the exact text as it appears
- If not found: write exactly NONE

What to extract: ${prompt}

Examples of correct output:
  Query: 'patient full name'  →  ליליינטל, אורה
  Query: 'phone number'       →  053-5619240
  Query: 'date of birth'      →  20/08/1955
  Query: 'doctor name'        →  Dr. Sarah Levy

---
${chunk}
---

${prompt}:`;
  document.getElementById('aiTesterPromptPreview').textContent = builtPrompt;
  document.getElementById('aiTesterPromptLog').style.display = 'block';

  try {
    const fd = new FormData();
    fd.append('sampleText',   text);
    fd.append('samplePrompt', prompt);
    if (model) fd.append('testModel', model);
    const r = await fetch('/admin/settings?handler=TestAiExtraction', {
      method: 'POST',
      headers: { 'RequestVerificationToken': getToken() },
      body: fd
    });
    const data = await r.json();

    const modelLabel = data.modelUsed ? `<span style="font-size:11px;color:var(--text3);margin-left:4px">model: ${escHtml(data.modelUsed)}</span>` : '';
    const latencyLabel = data.latencyMs ? `${data.latencyMs} ms` : '';

    const matchesHtml = data.ok && data.matches?.length
      ? data.matches.map(m =>
          `<div style="display:flex;gap:8px;align-items:center;padding:4px 0;border-bottom:1px solid var(--border)">
            <span style="font-family:monospace;background:rgba(255,77,79,.12);color:#ff4d4f;padding:2px 6px;border-radius:4px">${escHtml(m.matchedText ?? m.value ?? String(m))}</span>
            <span style="font-size:11px;color:var(--text3)">pos ${m.startIndex ?? '?'}</span>
          </div>`).join('')
      : data.ok
        ? '<span style="color:var(--text3);font-size:13px">No matches found.</span>'
        : `<span style="color:#ff4d4f;font-size:13px">⚠ ${escHtml(data.error ?? 'Unknown error')}</span>`;

    document.getElementById('aiTesterMatchesBox').innerHTML = matchesHtml;
    document.getElementById('aiTesterLatency').textContent  = latencyLabel;
    document.getElementById('aiTesterLatency').insertAdjacentHTML('afterend', modelLabel);
    resultBox.style.display = 'block';
  } catch (e) {
    document.getElementById('aiTesterMatchesBox').innerHTML =
      `<span style="color:#ff4d4f;font-size:13px">⚠ ${escHtml(e.message)}</span>`;
    resultBox.style.display = 'block';
  } finally {
    btn.disabled    = false;
    btn.textContent = '▶ Run Extraction';
  }
}

// ── Debug Trace ──────────────────────────────────────────────────────────
let _lastDebugTrace = null;

async function runDebugTrace() {
  // Prefer OCR'd text from file analysis cards; fall back to the text tab
  let text = '';
  if (cardStates.size > 0) {
    text = [...cardStates.values()].map(s => s.ocrText || '').join('\n').trim();
  }
  if (!text) {
    text = document.getElementById('textInput')?.value?.trim() || '';
  }
  if (!text) {
    alert('Run a file analysis or enter text in the Text tab first, then click Debug Trace.');
    return;
  }
  const btn = document.getElementById('debugBtn');
  btn.disabled = true;
  btn.textContent = '⏳ Running…';
  const panel = document.getElementById('debugPanel');
  const content = document.getElementById('debugContent');
  panel.style.display = 'block';
  content.innerHTML = '<div style="color:var(--text3);font-size:12px;padding:8px 0">Running per-pattern timing… please wait</div>';
  try {
    const res = await fetch('?handler=Debug', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('[name=__RequestVerificationToken]')?.value || '' },
      body: JSON.stringify({ text })
    });
    if (!res.ok) { content.innerHTML = `<span style="color:#ff4d4f">Error ${res.status}</span>`; return; }
    const d = await res.json();
    _lastDebugTrace = d;
    renderDebugTrace(d, content);
  } catch(e) {
    content.innerHTML = `<span style="color:#ff4d4f">Request failed: ${e.message}</span>`;
  } finally {
    btn.disabled = false;
    btn.textContent = '🐛 Debug Trace';
  }
}

function renderDebugTrace(d, container) {
  const slowMs = 200;
  let html = `<div style="font-family:monospace;font-size:12px;line-height:1.7">`;
  html += `<div style="color:var(--text3);margin-bottom:8px">`;
  html += `<b>Timestamp:</b> ${d.timestamp} &nbsp;|&nbsp; `;
  html += `<b>Runtime:</b> ${d.dotnetVersion} &nbsp;|&nbsp; `;
  html += `<b>CPUs:</b> ${d.cpuCount} &nbsp;|&nbsp; `;
  html += `<b>Text:</b> ${d.textCharCount.toLocaleString()} chars / ${d.textWordCount.toLocaleString()} words`;
  html += `</div>`;
  html += `<div style="margin-bottom:10px;font-size:13px">`;
  html += `<b>Total (sequential):</b> <span style="color:${d.totalDurationMs>1000?'#ff4d4f':d.totalDurationMs>300?'#faad14':'#52c41a'}">${d.totalDurationMs} ms</span>`;
  html += ` across ${d.totalFieldCount} fields`;
  html += `</div>`;

  // Table
  html += `<table style="width:100%;border-collapse:collapse;font-size:11.5px">`;
  html += `<thead><tr style="border-bottom:2px solid var(--border);color:var(--text3)">`;
  html += `<th style="text-align:left;padding:3px 8px 3px 0">Field</th>`;
  html += `<th style="text-align:left;padding:3px 8px">Pattern</th>`;
  html += `<th style="text-align:left;padding:3px 8px">Type</th>`;
  html += `<th style="text-align:right;padding:3px 0 3px 8px">Matches</th>`;
  html += `<th style="text-align:right;padding:3px 0 3px 8px">ms</th>`;
  html += `<th style="padding:3px 0 3px 8px"></th>`;
  html += `</tr></thead><tbody>`;

  for (const f of d.fields) {
    const fieldColor = f.durationMs > slowMs ? '#ff4d4f' : f.durationMs > 100 ? '#faad14' : 'var(--text)';
    if (!f.patterns || f.patterns.length === 0) {
      html += `<tr style="border-bottom:1px solid var(--border)">`;
      html += `<td style="padding:3px 8px 3px 0;font-weight:600;color:${fieldColor}">${esc(f.fieldName)}</td>`;
      html += `<td style="padding:3px 8px;color:var(--text3)" colspan="4">(no patterns)</td>`;
      html += `</tr>`;
      continue;
    }
    f.patterns.forEach((p, i) => {
      const pColor = p.durationMs > slowMs ? '#ff4d4f' : p.durationMs > 100 ? '#faad14' : 'var(--text2)';
      const slow   = p.durationMs > slowMs ? ' ⚠️ SLOW' : '';
      html += `<tr style="border-bottom:1px solid var(--border)">`;
      if (i === 0) html += `<td rowspan="${f.patterns.length}" style="padding:3px 8px 3px 0;font-weight:600;vertical-align:top;color:${fieldColor};border-right:2px solid var(--border)">${esc(f.fieldName)}<br><small style="font-weight:400;color:var(--text3)">${f.durationMs} ms total</small></td>`;
      html += `<td style="padding:3px 8px;max-width:260px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${esc(p.patternSnip)}">${esc(p.patternSnip)}</td>`;
      html += `<td style="padding:3px 8px;color:var(--text3)">${esc(p.patternType)}</td>`;
      html += `<td style="padding:3px 0 3px 8px;text-align:right">${p.matchCount}</td>`;
      html += `<td style="padding:3px 0 3px 8px;text-align:right;color:${pColor};font-weight:${p.durationMs>slowMs?700:400}">${p.durationMs}</td>`;
      html += `<td style="padding:3px 0 3px 4px;color:#ff4d4f;white-space:nowrap">${slow}${p.error?'<span title="'+esc(p.error)+'">❌</span>':''}</td>`;
      html += `</tr>`;
    });
  }
  html += `</tbody></table></div>`;
  container.innerHTML = html;
}

function esc(s) {
  return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function buildDebugText(d) {
  const lines = [];
  lines.push('=== PiiRemover Debug Trace ===');
  lines.push(`Timestamp : ${d.timestamp}`);
  lines.push(`Runtime   : ${d.dotnetVersion}`);
  lines.push(`OS        : ${d.os}`);
  lines.push(`CPUs      : ${d.cpuCount}`);
  lines.push(`Text      : ${d.textCharCount} chars / ${d.textWordCount} words`);
  lines.push(`Total     : ${d.totalDurationMs} ms (sequential, ${d.totalFieldCount} fields)`);
  lines.push('');
  lines.push('Field                    | Pattern type  | ms    | Matches | Pattern (truncated)');
  lines.push('-'.repeat(100));
  for (const f of d.fields) {
    for (const p of (f.patterns || [])) {
      const field   = f.fieldName.padEnd(24).slice(0,24);
      const type    = p.patternType.padEnd(13).slice(0,13);
      const ms      = String(p.durationMs).padStart(5);
      const matches = String(p.matchCount).padStart(7);
      const slow    = p.durationMs > 200 ? ' *** SLOW ***' : '';
      lines.push(`${field} | ${type} | ${ms} | ${matches} | ${p.patternSnip}${slow}`);
    }
  }
  return lines.join('\n');
}

async function copyDebugTrace() {
  if (!_lastDebugTrace) return;
  try {
    await navigator.clipboard.writeText(buildDebugText(_lastDebugTrace));
    const btn = document.getElementById('copyTraceBtn');
    btn.textContent = '✅ Copied!';
    setTimeout(() => { btn.textContent = '📋 Copy to Clipboard'; }, 2000);
  } catch(e) {
    alert('Copy failed: ' + e.message);
  }
}

// ── Download redacted text as a .txt file ────────────────────────────────
function downloadRedacted(cardId, originalName) {
  const s = cardStates.get(cardId);
  if (!s || !s.redactedText) {
    alert('No redacted text available for this file.');
    return;
  }
  const baseName = (originalName || 'document').replace(/\.[^.]+$/, '');
  const fileName = 'redacted_' + baseName + '.txt';
  const blob = new Blob([s.redactedText], { type: 'text/plain;charset=utf-8' });
  const url  = URL.createObjectURL(blob);
  const a    = document.createElement('a');
  a.href     = url;
  a.download = fileName;
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  setTimeout(() => URL.revokeObjectURL(url), 2000);
}
</script>
