@page "/admin/logs"
@model PiiRemover.Api.Pages.Admin.LogsModel
@using System.Text.Json
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Request Logs";
    ViewData["Nav"] = "logs";
}

@functions {
    static List<string> ParseFields(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return new();
        try { return JsonSerializer.Deserialize<List<string>>(json) ?? new(); }
        catch { return new(); }
    }

    static string EventTypeBadgeStyle(string et) => et switch
    {
        "ImageRedaction"  => "background:rgba(82,196,26,.12);color:#52c41a;border-color:rgba(82,196,26,.25)",
        "OcrExtract"      => "background:rgba(250,173,20,.12);color:#d48806;border-color:rgba(250,173,20,.25)",
        "VideoProcessing" => "background:rgba(114,46,209,.12);color:#7c3aed;border-color:rgba(114,46,209,.25)",
        _                 => "background:rgba(26,111,240,.12);color:#1a6ff0;border-color:rgba(26,111,240,.2)"
    };
}

<h1 class="page-title">Request Logs</h1>

<!-- ── Event-type aggregation bar ───────────────────────────────── -->
@if (Model.EventTypeCounts.Any())
{
<div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:12px">
  @foreach (var et in Model.EventTypeCounts)
  {
    var label = LogsModel.EventTypeLabels.TryGetValue(et.EventType, out var l) ? l : et.EventType;
    var active = Model.FilterEventType == et.EventType;
    var href   = active
        ? Model.PageUrl(1).Replace($"&eventType={Uri.EscapeDataString(et.EventType)}", "").Replace($"eventType={Uri.EscapeDataString(et.EventType)}&", "").Replace($"?eventType={Uri.EscapeDataString(et.EventType)}", "?")
        : (Model.PageUrl(1).Contains('?') ? Model.PageUrl(1) + $"&eventType={Uri.EscapeDataString(et.EventType)}" : $"/admin/logs?page=1&eventType={Uri.EscapeDataString(et.EventType)}");
    <a href="@href" style="display:flex;align-items:center;gap:6px;padding:7px 14px;border-radius:8px;border:1px solid;text-decoration:none;font-size:13px;transition:opacity .15s;@EventTypeBadgeStyle(et.EventType)@(active ? ";outline:2px solid currentColor;outline-offset:1px" : "")">
      @label
      <strong>@et.Count.ToString("N0")</strong>
    </a>
  }
</div>
}

<!-- ── Filter bar ───────────────────────────────────────────────── -->
<div class="card" style="margin-bottom:12px;padding:14px 18px">
  <form method="get" action="/admin/logs" style="display:flex;flex-wrap:wrap;gap:10px;align-items:flex-end">
    <div>
      <label style="font-size:11px;color:var(--text3);display:block;margin-bottom:3px">From</label>
      <input type="date" name="from" value="@Model.FilterFrom" style="padding:4px 8px;width:140px" />
    </div>
    <div>
      <label style="font-size:11px;color:var(--text3);display:block;margin-bottom:3px">To</label>
      <input type="date" name="to" value="@Model.FilterTo" style="padding:4px 8px;width:140px" />
    </div>
    <div>
      <label style="font-size:11px;color:var(--text3);display:block;margin-bottom:3px">Client</label>
      <select name="clientId" style="padding:4px 8px;width:160px">
        <option value="">All clients</option>
        @foreach (var c in Model.AllClients)
        {
            @if (Model.FilterClientId == c.Id)
            { <option value="@c.Id" selected>@c.Name</option> }
            else
            { <option value="@c.Id">@c.Name</option> }
        }
      </select>
    </div>
    <div>
      <label style="font-size:11px;color:var(--text3);display:block;margin-bottom:3px">Event type</label>
      <select name="eventType" style="padding:4px 8px;width:170px">
        <option value="">All types</option>
        @foreach (var kv in LogsModel.EventTypeLabels)
        {
            @if (Model.FilterEventType == kv.Key)
            { <option value="@kv.Key" selected>@kv.Value</option> }
            else
            { <option value="@kv.Key">@kv.Value</option> }
        }
      </select>
    </div>
    <div>
      <label style="font-size:11px;color:var(--text3);display:block;margin-bottom:3px">File name</label>
      <input type="text" name="fileName" value="@Model.FilterFileName" placeholder="search…" style="padding:4px 8px;width:160px" />
    </div>
    <button type="submit" class="btn btn-primary btn-sm">🔍 Filter</button>
    @if (Model.IsFiltered)
    {
      <a href="/admin/logs" class="btn btn-default btn-sm">✕ Clear</a>
    }
    <a href="@Model.CsvExportUrl" class="btn btn-default btn-sm" style="margin-left:auto">⬇ Export CSV</a>
  </form>
</div>

<div class="card">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
        <span style="color:#666">Showing page <strong>@Model.CurrentPage</strong> of <strong>@Model.PageCount</strong>
            — <strong>@Model.Total.ToString("N0")</strong> @(Model.IsFiltered ? "filtered" : "total") entries</span>
        <div style="display:flex;gap:8px">
            @if (Model.CurrentPage > 1)
            {
                <a href="@Model.PageUrl(Model.CurrentPage - 1)" class="btn btn-default btn-sm">← Prev</a>
            }
            @if (Model.CurrentPage < Model.PageCount)
            {
                <a href="@Model.PageUrl(Model.CurrentPage + 1)" class="btn btn-default btn-sm">Next →</a>
            }
        </div>
    </div>

    <table>
        <tr>
            <th style="width:60px">ID</th>
            <th style="width:80px">Client</th>
            <th style="width:150px">Time</th>
            <th style="width:140px">Event Type</th>
            <th>File</th>
            <th style="width:80px">Size KB</th>
            <th style="width:90px">Duration ms</th>
            <th>Fields Hit</th>
            <th>Error</th>
        </tr>
        @foreach (var log in Model.Logs)
        {
            <tr>
                <td>@log.Id</td>
                <td>@log.ClientId</td>
                <td style="font-size:12px;white-space:nowrap">@log.RequestedAt</td>
                <td>
                    @{
                        var et = log.EventType ?? "TextRedaction";
                        var etLabel = LogsModel.EventTypeLabels.TryGetValue(et, out var etl) ? etl : et;
                    }
                    <span style="display:inline-block;border:1px solid;border-radius:4px;padding:1px 7px;font-size:11px;white-space:nowrap;@EventTypeBadgeStyle(et)">@etLabel</span>
                </td>
                <td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"
                    title="@log.FileName">@log.FileName</td>
                <td>@log.FileSizeKb</td>
                <td>@log.DurationMs</td>
                <td style="font-size:12px">
                    @{
                        var fields = ParseFields(log.FieldsHit);
                    }
                    @if (fields.Any())
                    {
                        @foreach (var f in fields)
                        {
                            <span style="display:inline-block;background:rgba(26,111,240,.12);color:#4a90d9;border:1px solid rgba(26,111,240,.2);border-radius:4px;padding:1px 6px;margin:1px 2px;font-size:11px;white-space:nowrap">@f</span>
                        }
                    }
                    else
                    {
                        <span style="color:#aaa">—</span>
                    }
                </td>
                <td style="color:#cf1322;font-size:12px">@log.ErrorMsg</td>
            </tr>
        }
    </table>

    @if (Model.Logs.Any() == false)
    {
        <p style="text-align:center;color:#aaa;padding:24px 0">No log entries found.</p>
    }

    <div style="display:flex;justify-content:flex-end;gap:8px;margin-top:14px">
        @if (Model.CurrentPage > 1)
        {
            <a href="@Model.PageUrl(Model.CurrentPage - 1)" class="btn btn-default btn-sm">← Prev</a>
        }
        @if (Model.CurrentPage < Model.PageCount)
        {
            <a href="@Model.PageUrl(Model.CurrentPage + 1)" class="btn btn-default btn-sm">Next →</a>
        }
    </div>
</div>
