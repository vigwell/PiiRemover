@page "/admin/clients"
@model PiiRemover.Api.Pages.Admin.ClientsModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Clients";
    ViewData["Nav"] = "clients";
}

<h1 class="page-title">Clients &amp; API Keys</h1>

@if (!string.IsNullOrEmpty(Model.NewApiKey))
{
    <div class="alert alert-success">
        ✅ New API key generated — <strong>copy it now, it won't be shown again:</strong><br/>
        <span class="mono" style="font-size:13px;user-select:all" id="newApiKeySpan">@Model.NewApiKey</span>
        &nbsp;<button class="btn btn-default btn-sm" onclick="copyKey(document.getElementById('newApiKeySpan').textContent, this)">📋 Copy</button>
    </div>
}

<div class="card">
    <h3>Add Client</h3>
    <form method="post" asp-page-handler="Create" style="display:flex;gap:8px">
        <input type="text" asp-for="NewName" placeholder="Client name" required style="max-width:280px" />
        <button class="btn btn-primary" type="submit">Create Client</button>
    </form>
</div>

<div class="card">
    <h3>All Clients</h3>
    <table>
        <tr>
            <th>ID</th><th>Name</th><th>Status</th><th>Created</th><th>Webhook URL</th><th>Actions</th>
        </tr>
        @foreach (var c in Model.Clients)
        {
            <tr>
                <td>@c.Id</td>
                <td><strong>@c.Name</strong></td>
                <td>
                    @if (c.IsActive)
                    { <span class="badge badge-green">Active</span> }
                    else
                    { <span class="badge badge-red">Disabled</span> }
                </td>
                <td style="font-size:12px;white-space:nowrap">@c.CreatedAt</td>
                <td style="font-size:12px;max-width:200px">
                    <form method="post" asp-page-handler="UpdateWebhook" style="display:flex;gap:4px">
                        <input type="hidden" name="id" value="@c.Id" />
                        <input type="text" name="webhookUrl" value="@c.WebhookUrl"
                               placeholder="https://…" style="font-size:11px;padding:3px 6px"
                               title="POST payload sent here after each redaction call" />
                        <button type="submit" class="btn btn-default btn-sm" title="Save webhook URL">💾</button>
                    </form>
                </td>
                <td style="display:flex;gap:6px;flex-wrap:wrap">
                    <form method="post" asp-page-handler="Toggle">
                        <input type="hidden" name="id" value="@c.Id" />
                        <button type="submit" class="btn btn-default btn-sm">
                            @(c.IsActive ? "Disable" : "Enable")
                        </button>
                    </form>
                    <form method="post" asp-page-handler="Regenerate">
                        <input type="hidden" name="id" value="@c.Id" />
                        <button type="submit" class="btn btn-default btn-sm">🔑 Regen Key</button>
                    </form>
                    <a href="/admin/client-usage/@c.Id" class="btn btn-default btn-sm" title="View usage stats">📈 Usage</a>
                </td>
            </tr>
        }
    </table>
</div>

<script>
/* One-click copy API key */
function copyKey(key, btn) {
  navigator.clipboard.writeText(key).then(function() {
    var orig = btn.textContent;
    btn.textContent = '✓ Copied';
    btn.style.color = '#52c41a';
    setTimeout(function() { btn.textContent = orig; btn.style.color = ''; }, 1600);
  }).catch(function() { alert('Copy failed — please select and copy manually.'); });
}
</script>
